# 이 파일을 복사해서 .env.local 로 이름을 바꾸고 값을 채우세요. (.env.local 은 절대 커밋하지 않기)

# ── DB: 둘 중 하나 ─────────────────────────────────────────────
# 로컬 (docker compose up -d)
DATABASE_URL=postgres://michelin:michelin@localhost:5432/michelin
# Supabase → Connect → Session pooler 주소 ([YOUR-PASSWORD] 를 실제 비밀번호로)
# DATABASE_URL=postgresql://postgres.xxxx:비밀번호@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres

# ── 네이버 뉴스 (NAVER API HUB 콘솔에서 발급) — 이슈·언급량·최신 동향 ──
NAVER_HUB_CLIENT_ID=
NAVER_HUB_CLIENT_SECRET=

# ── 선관위 (공공데이터포털, Decoding 키) — 후보·득표수·득표율·투표율 ──
DATA_GO_KR_KEY=

# ── 열린국회정보 — 의원·정당·법안·표결 (연동 예정, 비워 둬도 됨) ──
ASSEMBLY_API_KEY=

# ── KOSIS 국가통계포털 (kosis.kr → 공유서비스 → OpenAPI 인증키) — 시도별 인구·고령화율·재정자립도 ──
KOSIS_API_KEY=
